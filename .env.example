# Planora AI Environment Configuration

# Firebase Web App Configuration (From Firebase Console -> Project Settings -> General -> Your apps -> Web)
VITE_FIREBASE_API_KEY=your_api_key_here
VITE_FIREBASE_AUTH_DOMAIN=your_project_id.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your_project_id
VITE_FIREBASE_STORAGE_BUCKET=your_project_id.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=your_sender_id
VITE_FIREBASE_APP_ID=your_app_id

# Server-Side Gemini API Key Secret
# Used exclusively by serverless endpoints (/api/ai/generate) and Vite dev middleware.
# NEVER prefix with VITE_ to prevent client-side bundle exposure.
GEMINI_API_KEY=your_gemini_api_key_here

# Optional: Demo Session HMAC Secret (if omitted, falls back to GEMINI_API_KEY)
DEMO_SESSION_SECRET=your_random_demo_signing_secret_here

# Optional AI Function URL override for non-Firebase-Hosting setups (e.g., https://us-central1-your_project_id.cloudfunctions.net/generateEventIdeas)
# Leave empty if using standard /api/ai/generate rewrites or local Vite dev server
VITE_AI_FUNCTION_URL=
